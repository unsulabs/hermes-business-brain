{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {"spans": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end", "sha256"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}},
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reference_id", "version_id", "locator", "owner", "authority", "evidence", "source_type", "admissibility", "sha256", "byte_length", "access_state", "reading_state", "reading_evidence", "sensitivity", "dependencies"],
  "properties": {
    "schema_version": {"const": "referencia-externa.v1"},
    "reference_id": {"type": "string", "pattern": "^ER-[A-Za-z0-9_-]{1,100}$"},
    "version_id": {"type": "string", "pattern": "^EV-[a-f0-9]{64}$"},
    "locator": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["local_file", "remote_url"]}, "value": {"type": "string", "minLength": 1}}},
    "owner": {"type": "string", "pattern": "\\S"},
    "authority": {"type": "string", "pattern": "\\S"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
    "source_type": {"enum": ["primary", "control", "external_reference"]},
    "note_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}},
    "admissibility": {"enum": ["admissible", "historical_only", "rejected"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "byte_length": {"type": ["integer", "null"], "minimum": 0},
    "access_state": {"enum": ["available", "unverified", "inaccessible"]},
    "reading_state": {"enum": ["unread", "partial", "complete"]},
    "reading_evidence": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "read_spans": {"$ref": "#/$defs/spans"},
    "sensitivity": {"enum": ["interno", "confidencial", "restringido"]},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["kind", "version_id", "sha256"], "properties": {"kind": {"enum": ["external", "transcript"]}, "reference_id": {"type": "string"}, "tr_id": {"type": "string"}, "version_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "spans": {"$ref": "#/$defs/spans"}}, "additionalProperties": false}}
  }
}
