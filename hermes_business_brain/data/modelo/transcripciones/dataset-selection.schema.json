{
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "exception": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_response": {
            "type": [
              "string",
              "null"
            ]
          },
          "expert_correction": {
            "type": [
              "string",
              "null"
            ]
          },
          "passages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "tr_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "version_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "context_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "context_end": {
                  "type": "integer",
                  "minimum": 0
                },
                "passage_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "context_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "tr_id",
                "version_id",
                "source_sha256",
                "start",
                "end",
                "context_start",
                "context_end",
                "passage_sha256",
                "context_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "candidate_id",
          "task",
          "criterion",
          "expected_result",
          "exception",
          "observed_response",
          "expert_correction",
          "passages"
        ],
        "additionalProperties": false
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "client": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "project": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "client",
          "project",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "allow_historical": {
      "type": "boolean"
    }
  },
  "required": [
    "candidates",
    "identities",
    "allow_historical"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
