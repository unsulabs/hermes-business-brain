{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "analisis.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tr_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "segmenter_version": {
      "type": "string",
      "minLength": 1
    },
    "analyzer_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "canonical_context_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "permission_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "supersedes_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "segment_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "sustantivo",
              "sin_asunto",
              "ilegible"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "segment_id",
          "status",
          "summary",
          "subject_ids",
          "claim_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "subject_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tr_id": {
                  "type": "string",
                  "minLength": 1
                },
                "version_id": {
                  "type": "string",
                  "minLength": 1
                },
                "text_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "excerpt_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "tr_id",
                "version_id",
                "text_sha256",
                "start",
                "end",
                "excerpt_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destination": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "canonical_unit",
                  "source"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "reason"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "classifications": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "category_id": {"type": "string", "minLength": 1},
                "axis": {"enum": ["asunto", "entidad", "actividad", "estado", "finalidad"]}
              },
              "required": ["category_id", "axis"],
              "additionalProperties": false
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "subject_id",
          "description",
          "evidence_spans",
          "claim_ids",
          "destination",
          "reasons",
          "exceptions",
          "classifications"
        ],
        "additionalProperties": false
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "examined_core_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_core_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "material_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "subjects_with_destination": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable_segment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "enum": [
            "parcial",
            "completa"
          ]
        },
        "semantic_acceptance": {
          "const": "pending_independent_review"
        }
      },
      "required": [
        "examined_core_bytes",
        "total_core_bytes",
        "material_subjects",
        "subjects_with_destination",
        "unreadable_segment_ids",
        "state",
        "semantic_acceptance"
      ],
      "additionalProperties": false
    },
    "global_reconciliation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "propuesta",
            "revisada"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "earlier_claim_id": {
                "type": "string",
                "minLength": 1
              },
              "later_claim_id": {
                "type": "string",
                "minLength": 1
              },
              "relation_id": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "earlier_claim_id",
              "later_claim_id",
              "relation_id",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "open_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "reviewer",
        "summary",
        "subject_ids",
        "corrections",
        "open_conflicts",
        "limitations"
      ],
      "additionalProperties": false
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "producer_version",
    "run_id",
    "tr_id",
    "version_id",
    "text_sha256",
    "segmenter_version",
    "analyzer_version",
    "taxonomy_version",
    "canonical_context_hashes",
    "permission_snapshot",
    "cache_key",
    "supersedes_run_id",
    "segment_results",
    "subject_matrix",
    "claim_ids",
    "relation_ids",
    "coverage",
    "global_reconciliation",
    "dependency_ids"
  ],
  "additionalProperties": false
}
