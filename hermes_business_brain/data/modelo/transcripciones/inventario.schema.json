{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "inventario.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "observed_identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "observed_identity"
      ],
      "additionalProperties": false
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "end_observed": {
            "type": "boolean"
          },
          "end_evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "end_observed",
          "end_evidence",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "complete",
              "partial",
              "unverified",
              "inaccessible",
              "failed"
            ]
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            }
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "state",
          "attempts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "producer_version",
    "snapshot_id",
    "account",
    "captured_at",
    "sections",
    "meetings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
