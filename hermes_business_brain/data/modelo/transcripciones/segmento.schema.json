{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "segmento.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "tr_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "segmenter_version": {
      "type": "string",
      "minLength": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "core_start": {
      "type": "integer",
      "minimum": 0
    },
    "core_end": {
      "type": "integer",
      "minimum": 0
    },
    "context_start": {
      "type": "integer",
      "minimum": 0
    },
    "context_end": {
      "type": "integer",
      "minimum": 0
    },
    "speaker_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "time_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundary_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "producer_version",
    "segment_id",
    "tr_id",
    "version_id",
    "text_sha256",
    "segmenter_version",
    "ordinal",
    "core_start",
    "core_end",
    "context_start",
    "context_end",
    "speaker_refs",
    "time_refs",
    "boundary_reason"
  ],
  "additionalProperties": false
}
